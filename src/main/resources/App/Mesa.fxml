<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="painelRaiz"
            prefHeight="720.0"
            prefWidth="1180.0"
            styleClass="app-shell"
            stylesheets="@Mesa.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="App.Controles.MesaController">

    <left>
        <VBox prefWidth="220.0"
              styleClass="sidebar">

            <padding>
                <Insets bottom="28.0"
                        left="14.0"
                        right="14.0"
                        top="30.0" />
            </padding>

            <VBox spacing="2.0"
                  styleClass="brand-block">

                <Label styleClass="brand-title"
                       text="MESA CERTA" />

                <Label styleClass="brand-subtitle"
                       text="Gestão de restaurante" />

            </VBox>

            <VBox spacing="8.0"
                  styleClass="navigation">

                <Button fx:id="botaoPainelInicial"
                        maxWidth="Infinity"
                        onAction="#abrirPainelInicial"
                        styleClass="menu-button, menu-button-active"
                        text="Painel inicial" />

                <Button fx:id="botaoProdutos"
                        managed="false"
                        maxWidth="Infinity"
                        onAction="#abrirProdutos"
                        styleClass="menu-button"
                        text="Cardápio"
                        visible="false" />

                <Button fx:id="botaoMesas"
                        maxWidth="Infinity"
                        onAction="#abrirDashboardMesas"
                        styleClass="menu-button"
                        text="Mesas" />

                <Button fx:id="botaoComandas"
                        maxWidth="Infinity"
                        onAction="#abrirListaComandas"
                        styleClass="menu-button"
                        text="Comandas" />

                <Button fx:id="botaoEstoque"
                        managed="false"
                        maxWidth="Infinity"
                        onAction="#abrirEstoque"
                        styleClass="menu-button"
                        text="Estoque"
                        visible="false" />

                <Button fx:id="botaoHistorico"
                        maxWidth="Infinity"
                        onAction="#abrirHistoricoVendas"
                        styleClass="menu-button"
                        text="Histórico" />

                <Button fx:id="botaoRelatorios"
                        maxWidth="Infinity"
                        onAction="#abrirRelatorios"
                        styleClass="menu-button"
                        text="Relatórios" />

            </VBox>

        </VBox>
    </left>

    <center>
        <BorderPane>

            <top>
                <HBox alignment="CENTER_LEFT"
                      minHeight="72.0"
                      styleClass="top-bar">

                    <padding>
                        <Insets left="32.0"
                                right="32.0" />
                    </padding>

                    <!-- TÍTULO -->
                    <Label fx:id="labelTituloPagina"
                           styleClass="page-title"
                           text="Painel inicial" />

                    <!-- ESPAÇO ENTRE O TÍTULO E AS AÇÕES -->
                    <Region HBox.hgrow="ALWAYS" />

                    <!-- Esta ação aparece somente na área de comandas. -->
                    <Button fx:id="botaoNovaComanda"
                            managed="false"
                            onAction="#abrirNovaComanda"
                            text="+ ABRIR COMANDA"
                            visible="false"
                            style="-fx-background-color: #F7941D;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 5;
                                   -fx-padding: 9 15 9 15;" />

                    <!-- USUÁRIO -->
                    <Label fx:id="labelUsuario"
                           styleClass="user-label"
                           text="Funcionário autorizado"
                           style="-fx-padding: 0 0 0 12;" />

                </HBox>
            </top>

            <center>
                <VBox spacing="18.0" styleClass="tables-content">
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="section-title" text="Mapa de mesas" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="botaoNovaMesa"
                                managed="false"
                                onAction="#adicionarNovaMesa"
                                styleClass="primary-button"
                                text="+ NOVA MESA"
                                visible="false" />
                    </HBox>

                    <ScrollPane fitToWidth="true"
                                styleClass="content-scroll"
                                VBox.vgrow="ALWAYS">
                        <content>
                            <TilePane fx:id="painelMesas"
                                      hgap="20.0"
                                      prefColumns="4"
                                      vgap="20.0"
                                      styleClass="tables-grid" />
                        </content>
                    </ScrollPane>
                </VBox>
            </center>

        </BorderPane>
    </center>

</BorderPane>

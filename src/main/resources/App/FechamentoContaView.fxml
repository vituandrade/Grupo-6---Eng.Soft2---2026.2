<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="App.Controles.FechamentoContaController"
            prefWidth="1180.0"
            prefHeight="720.0"
            style="-fx-background-color: #F5F7F8;">

    <top>
        <HBox alignment="CENTER_LEFT"
              prefHeight="62.0"
              style="-fx-background-color: white;">

            <padding>
                <Insets top="12"
                        right="28"
                        bottom="10"
                        left="26"/>
            </padding>

            <VBox spacing="3"
                  HBox.hgrow="ALWAYS">

                <Label text="Fechamento da conta"
                       style="-fx-font-size: 21px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #27343A;"/>

                <Label fx:id="labelComanda"
                       text="Comanda #107 • Mesa 07"
                       style="-fx-font-size: 14px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #34434A;"/>

            </VBox>

            <Label text="Funcionário autorizado"
                   style="-fx-font-size: 11px;
                          -fx-text-fill: #7A8890;"/>

        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER"
              spacing="14">

            <padding>
                <Insets top="14"
                        right="24"
                        bottom="24"
                        left="24"/>
            </padding>

            <HBox alignment="TOP_CENTER"
                  spacing="22"
                  maxWidth="1350.0">

                <VBox prefWidth="790.0"
                      minWidth="520.0"
                      maxWidth="790.0"
                      prefHeight="620.0"
                      maxHeight="620.0"
                      spacing="14"
                      style="-fx-background-color: white;
                             -fx-background-radius: 8;
                             -fx-border-color: #D8E0E3;
                             -fx-border-radius: 8;">

                    <padding>
                        <Insets top="18"
                                right="18"
                                bottom="18"
                                left="18"/>
                    </padding>

                    <Label text="Resumo da comanda"
                           style="-fx-font-size: 16px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #27343A;"/>

                    <ListView fx:id="listaItens"
                              prefHeight="145.0"
                              minHeight="145.0"
                              maxHeight="145.0"
                              fixedCellSize="30.0"
                              focusTraversable="false"
                              style="-fx-background-color: white;
                                     -fx-border-color: transparent;
                                     -fx-background-insets: 0;
                                     -fx-padding: 0;"/>

                    <Separator style="-fx-background-color: #E1E6E8;"/>

                    <VBox spacing="15">

                        <HBox alignment="CENTER_LEFT">

                            <Label text="Subtotal"
                                   style="-fx-font-size: 13px;
                                          -fx-text-fill: #7A8890;"/>

                            <Label fx:id="labelSubtotal"
                                   text="R$ 0,00"
                                   maxWidth="Infinity"
                                   HBox.hgrow="ALWAYS"
                                   alignment="CENTER_RIGHT"
                                   style="-fx-font-size: 13px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #526069;"/>

                        </HBox>

                        <HBox alignment="CENTER_LEFT">

                            <Label text="Desconto autorizado"
                                   style="-fx-font-size: 13px;
                                          -fx-text-fill: #7A8890;"/>

                            <Label fx:id="labelDesconto"
                                   text="R$ 0,00"
                                   maxWidth="Infinity"
                                   HBox.hgrow="ALWAYS"
                                   alignment="CENTER_RIGHT"
                                   style="-fx-font-size: 13px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #47A96B;"/>

                        </HBox>

                        <HBox alignment="CENTER_LEFT">

                            <Label text="TOTAL"
                                   style="-fx-font-size: 16px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #27343A;"/>

                            <Label fx:id="labelTotal"
                                   text="R$ 0,00"
                                   maxWidth="Infinity"
                                   HBox.hgrow="ALWAYS"
                                   alignment="CENTER_RIGHT"
                                   style="-fx-font-size: 21px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #27343A;"/>

                        </HBox>

                    </VBox>

                </VBox>

                <VBox prefWidth="510.0"
                      minWidth="360.0"
                      maxWidth="510.0"
                      prefHeight="620.0"
                      maxHeight="620.0"
                      spacing="12"
                      style="-fx-background-color: white;
                             -fx-background-radius: 8;
                             -fx-border-color: #D8E0E3;
                             -fx-border-radius: 8;">

                    <padding>
                        <Insets top="18"
                                right="18"
                                bottom="18"
                                left="18"/>
                    </padding>

                    <Label text="Pagamento presencial"
                           style="-fx-font-size: 16px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #27343A;"/>

                    <Label text="Forma de pagamento"
                           style="-fx-font-size: 12px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #3D4A50;"/>

                    <ComboBox fx:id="comboFormaPagamento"
                              prefHeight="40.0"
                              maxWidth="Infinity"
                              promptText="Selecione a forma de pagamento"
                              style="-fx-background-color: white;
                                     -fx-border-color: #D5DEE2;
                                     -fx-border-radius: 5;
                                     -fx-background-radius: 5;
                                     -fx-font-size: 13px;"/>

                    <Label text="Desconto"
                           style="-fx-font-size: 12px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #3D4A50;"/>

                    <TextField fx:id="campoDesconto"
                               text="0"
                               prefHeight="40.0"
                               maxWidth="Infinity"
                               style="-fx-background-color: white;
                                      -fx-border-color: #D5DEE2;
                                      -fx-border-radius: 5;
                                      -fx-background-radius: 5;
                                      -fx-font-size: 13px;"/>

                    <Label text="Exige permissão do perfil"
                           style="-fx-font-size: 10px;
                                  -fx-text-fill: #ED8E22;
                                  -fx-font-weight: bold;"/>

                    <VBox prefHeight="38.0"/>

                    <Button text="CONFIRMAR FECHAMENTO"
                            onAction="#confirmarFechamento"
                            prefHeight="42.0"
                            maxWidth="Infinity"
                            style="-fx-background-color: #ED8E22;
                                   -fx-text-fill: #1F2E33;
                                   -fx-background-radius: 5;
                                   -fx-font-size: 11px;
                                   -fx-font-weight: bold;"/>

                    <Button text="VOLTAR À COMANDA"
                            onAction="#voltar"
                            prefHeight="38.0"
                            maxWidth="Infinity"
                            style="-fx-background-color: white;
                                   -fx-text-fill: #45545C;
                                   -fx-border-color: #D5DEE2;
                                   -fx-border-radius: 5;
                                   -fx-background-radius: 5;
                                   -fx-font-size: 11px;
                                   -fx-font-weight: bold;"/>

                </VBox>

            </HBox>

        </VBox>
    </center>

</BorderPane>
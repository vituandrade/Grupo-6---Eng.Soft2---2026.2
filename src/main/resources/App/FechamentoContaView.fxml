<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListCell?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="App.Controles.FechamentoContaController"
            prefWidth="1180.0"
            prefHeight="720.0"
            style="-fx-background-color: #F4F7F9;"
            stylesheets="@Mesa.css">

    <top>
        <HBox alignment="CENTER_LEFT"
              minHeight="72.0"
              prefHeight="72.0"
              style="-fx-background-color: white; -fx-border-color: transparent transparent #E8EDEF transparent;">
            <padding>
                <Insets left="32.0" right="32.0"/>
            </padding>

            <Label text="Fechamento da conta"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1D2C32;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="Funcionário autorizado"
                   style="-fx-font-size: 13px; -fx-text-fill: #718087;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="16.0">
            <padding>
                <Insets top="22.0" right="34.0" bottom="30.0" left="34.0"/>
            </padding>

            <Label fx:id="labelComanda"
                   text="Comanda #107 • Mesa 07"
                   style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #27343A;"/>

            <HBox spacing="24.0"
                  alignment="TOP_CENTER"
                  VBox.vgrow="ALWAYS">

                <VBox prefWidth="720.0"
                      minWidth="560.0"
                      maxWidth="760.0"
                      spacing="14.0"
                      style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #D8E0E3; -fx-border-radius: 8;">
                    <padding>
                        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
                    </padding>

                    <Label text="Resumo da comanda"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #27343A;"/>

                    <ListView fx:id="listaItens"
                              prefHeight="220.0"
                              minHeight="220.0"
                              maxHeight="220.0"
                              fixedCellSize="42.0"
                              focusTraversable="false"
                              style="-fx-background-color: white; -fx-border-color: #EEF1F2; -fx-border-radius: 4; -fx-background-insets: 0;"/>

                    <Separator style="-fx-background-color: #E1E6E8;"/>

                    <VBox spacing="10.0">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Subtotal"
                                   style="-fx-font-size: 14px; -fx-text-fill: #7A8890;"/>
                            <Label fx:id="labelSubtotal"
                                   text="R$ 0,00"
                                   maxWidth="Infinity"
                                   HBox.hgrow="ALWAYS"
                                   alignment="CENTER_RIGHT"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #526069;"/>
                        </HBox>

                        <HBox alignment="CENTER_LEFT">
                            <Label text="Desconto autorizado"
                                   style="-fx-font-size: 14px; -fx-text-fill: #7A8890;"/>
                            <Label fx:id="labelDesconto"
                                   text="R$ 0,00"
                                   maxWidth="Infinity"
                                   HBox.hgrow="ALWAYS"
                                   alignment="CENTER_RIGHT"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #47A96B;"/>
                        </HBox>

                        <HBox alignment="CENTER_LEFT">
                            <Label text="TOTAL"
                                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #27343A;"/>
                            <Label fx:id="labelTotal"
                                   text="R$ 0,00"
                                   maxWidth="Infinity"
                                   HBox.hgrow="ALWAYS"
                                   alignment="CENTER_RIGHT"
                                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #27343A;"/>
                        </HBox>
                    </VBox>
                </VBox>

                <VBox prefWidth="360.0"
                      minWidth="320.0"
                      maxWidth="390.0"
                      spacing="9.0"
                      style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #D8E0E3; -fx-border-radius: 8;">
                    <padding>
                        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
                    </padding>

                    <Label text="Pagamento presencial"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #27343A;"/>

                    <Label text="Forma de pagamento"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3D4A50;"/>

                    <ComboBox fx:id="comboFormaPagamento"
                              prefHeight="46.0"
                              maxWidth="Infinity"
                              promptText="Selecione a forma de pagamento"
                              style="-fx-background-color: white; -fx-border-color: #D5DEE2; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-size: 14px;"/>

                    <Label text="Desconto"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3D4A50;"/>

                    <TextField fx:id="campoDesconto"
                               text="0"
                               prefHeight="46.0"
                               maxWidth="Infinity"
                               style="-fx-background-color: white; -fx-border-color: #D5DEE2; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-size: 14px;"/>

                    <Label text="Exige permissão do perfil"
                           style="-fx-font-size: 12px; -fx-text-fill: #ED8E22; -fx-font-weight: bold;"/>

                    <Region VBox.vgrow="ALWAYS"/>

                    <Button text="CONFIRMAR FECHAMENTO"
                            onAction="#confirmarFechamento"
                            prefHeight="46.0"
                            maxWidth="Infinity"
                            style="-fx-background-color: #ED8E22; -fx-text-fill: white; -fx-background-radius: 4; -fx-font-size: 12px; -fx-font-weight: bold;"/>

                    <Button text="VOLTAR À COMANDA"
                            onAction="#voltar"
                            prefHeight="44.0"
                            maxWidth="Infinity"
                            style="-fx-background-color: white; -fx-text-fill: #45545C; -fx-border-color: #D5DEE2; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>

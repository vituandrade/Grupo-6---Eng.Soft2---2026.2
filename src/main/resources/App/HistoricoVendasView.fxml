<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="App.Controles.HistoricoVendasController"
            style="-fx-background-color: #F4F7F9;"
            stylesheets="@HistoricoVendas.css">

    <center>
        <VBox spacing="14.0">
            <padding>
                <Insets top="22.0" right="34.0" bottom="30.0" left="34.0"/>
            </padding>

            <VBox spacing="14.0"
                  VBox.vgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 6; -fx-border-color: #D8E0E3; -fx-border-radius: 6;">
                <padding>
                    <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
                </padding>

                <Label text="Comandas fechadas"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #27343A;"/>

                <HBox spacing="14.0"
                      alignment="CENTER_LEFT">
                    <VBox spacing="3.0" prefWidth="190.0">
                        <Label text="Data inicial"
                               style="-fx-font-size: 13px; -fx-text-fill: #7A8890;"/>
                        <TextField fx:id="campoDataInicial"
                                   promptText="DD/MM/AAAA"
                                   prefHeight="44.0"/>
                    </VBox>

                    <VBox spacing="3.0" prefWidth="190.0">
                        <Label text="Data final"
                               style="-fx-font-size: 13px; -fx-text-fill: #7A8890;"/>
                        <TextField fx:id="campoDataFinal"
                                   promptText="DD/MM/AAAA"
                                   prefHeight="44.0"/>
                    </VBox>

                    <VBox spacing="3.0" prefWidth="230.0">
                        <Label text="Forma de pagamento"
                               style="-fx-font-size: 13px; -fx-text-fill: #7A8890;"/>
                        <ComboBox fx:id="comboFormaPagamento"
                                  maxWidth="Infinity"
                                  prefHeight="44.0"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button fx:id="botaoFiltrar"
                            text="FILTRAR"
                            onAction="#filtrar"
                            prefWidth="130.0"
                            prefHeight="44.0"
                            style="-fx-background-color: #ED8E22; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4; -fx-font-size: 12px;"/>
                </HBox>

                <TableView fx:id="tabelaVendas"
                           VBox.vgrow="ALWAYS"
                           styleClass="historico-table">
                    <columns>
                        <TableColumn fx:id="colunaComanda" text="Comanda" prefWidth="100"/>
                        <TableColumn fx:id="colunaAtendimento" text="Atendimento" prefWidth="190"/>
                        <TableColumn fx:id="colunaDataHora" text="Data/Hora" prefWidth="170"/>
                        <TableColumn fx:id="colunaPagamento" text="Pagamento" prefWidth="175"/>
                        <TableColumn fx:id="colunaTotal" text="Total" prefWidth="150"/>
                        <TableColumn fx:id="colunaFuncionario" text="Funcionário" prefWidth="150"/>
                    </columns>
                </TableView>

                <Label fx:id="labelMensagem"
                       minHeight="24.0"
                       style="-fx-font-size: 13px; -fx-text-fill: #7A8890;"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" styleClass="cardapio-view" stylesheets="@Cardapio.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="App.Controles.ProdutosController">
    <padding>
        <Insets bottom="30.0" left="34.0" right="34.0" top="26.0" />
    </padding>

    <HBox alignment="CENTER_LEFT">
        <Label styleClass="section-title" text="Itens do cardápio" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="botaoNovoItem" onAction="#abrirCadastro" prefHeight="42.0"
                prefWidth="196.0" styleClass="primary-button" text="+ NOVO ITEM" />
    </HBox>

    <HBox spacing="20.0">
        <TextField fx:id="campoBusca" prefHeight="40.0" promptText="Buscar por nome ou categoria..."
                   styleClass="search-field" HBox.hgrow="ALWAYS" />
        <ComboBox fx:id="filtroCategoria" prefHeight="40.0" prefWidth="222.0"
                  styleClass="filter-combo" />
    </HBox>

    <TableView fx:id="tabelaItens" styleClass="cardapio-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colunaNome" prefWidth="320.0" text="Nome" />
            <TableColumn fx:id="colunaCategoria" prefWidth="180.0" text="Categoria" />
            <TableColumn fx:id="colunaPreco" prefWidth="140.0" text="Preço" />
            <TableColumn fx:id="colunaDisponibilidade" prefWidth="200.0" text="Disponibilidade" />
        </columns>
    </TableView>

    <Label fx:id="labelMensagem" minHeight="20.0" styleClass="page-message" />
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="800.0" prefWidth="1280.0" styleClass="login-root"
      stylesheets="@Login.css" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="App.Controles.LoginController">
    <children>
        <VBox minWidth="470.0" prefWidth="470.0" styleClass="brand-panel">
            <padding>
                <Insets left="64.0" right="50.0" top="100.0" />
            </padding>

            <Label styleClass="brand-title" text="MESA CERTA" />
            <Label styleClass="brand-subtitle" text="Gestão de restaurante" />

            <Label styleClass="brand-message"
                   text="Controle local,&#10;simples e confiável.">
                <VBox.margin>
                    <Insets top="64.0" />
                </VBox.margin>
            </Label>
            <Label styleClass="brand-description"
                   text="Mesas, comandas e cardápio organizados&#10;em um só lugar." />
        </VBox>

        <StackPane styleClass="login-content" HBox.hgrow="ALWAYS">
            <children>
                <VBox maxHeight="520.0" maxWidth="460.0" minHeight="520.0"
                      minWidth="460.0" prefHeight="520.0" prefWidth="460.0"
                      styleClass="login-card">
                    <padding>
                        <Insets bottom="40.0" left="58.0" right="58.0" top="52.0" />
                    </padding>

                    <Label styleClass="login-title" text="Entrar no sistema" />
                    <Label styleClass="login-subtitle"
                           text="Use suas credenciais de funcionário" />

                    <Label styleClass="field-label" text="Usuário">
                        <VBox.margin>
                            <Insets top="38.0" />
                        </VBox.margin>
                    </Label>
                    <TextField fx:id="campoUsuario" maxWidth="Infinity"
                               prefHeight="46.0" promptText="Digite seu usuário">
                        <VBox.margin>
                            <Insets top="8.0" />
                        </VBox.margin>
                    </TextField>

                    <Label styleClass="field-label" text="Senha">
                        <VBox.margin>
                            <Insets top="22.0" />
                        </VBox.margin>
                    </Label>
                    <PasswordField fx:id="campoSenha" maxWidth="Infinity"
                                   prefHeight="46.0" promptText="Digite sua senha">
                        <VBox.margin>
                            <Insets top="8.0" />
                        </VBox.margin>
                    </PasswordField>

                    <Label fx:id="mensagemErro" maxWidth="Infinity"
                           minHeight="30.0" styleClass="error-message"
                           wrapText="true">
                        <VBox.margin>
                            <Insets top="8.0" />
                        </VBox.margin>
                    </Label>

                    <Button defaultButton="true" maxWidth="Infinity"
                            onAction="#fazerLogin" prefHeight="46.0"
                            styleClass="login-button" text="ENTRAR" />

                    <Region VBox.vgrow="ALWAYS" />
                    <Label maxWidth="Infinity" styleClass="login-footer"
                           text="Aplicação JavaFX • Uso local" />
                </VBox>
            </children>
        </StackPane>
    </children>
</HBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="App.Controles.GerenciarMesaController"
            prefWidth="620.0"
            prefHeight="650.0"
            style="-fx-background-color: #F5F7F8;">

    <!-- CABEÇALHO -->
    <top>
        <VBox spacing="5"
              style="-fx-background-color: #0F2833;">

            <padding>
                <Insets top="24"
                        right="28"
                        bottom="22"
                        left="28"/>
            </padding>

            <Label fx:id="labelTituloMesa"
                   text="Gerenciando Mesa"
                   style="-fx-text-fill: white;
                          -fx-font-size: 25px;
                          -fx-font-weight: bold;"/>

            <Label text="Comanda aberta vinculada a esta mesa"
                   style="-fx-text-fill: #C8D2D6;
                          -fx-font-size: 14px;"/>

        </VBox>
    </top>


    <!-- CONTEÚDO -->
    <center>
        <VBox spacing="12">

            <padding>
                <Insets top="25"
                        right="28"
                        bottom="15"
                        left="28"/>
            </padding>

            <Label text="Comanda em atendimento"
                   style="-fx-text-fill: #23343B;
                          -fx-font-size: 17px;
                          -fx-font-weight: bold;"/>

            <ListView fx:id="listaComandas"
                      VBox.vgrow="ALWAYS"
                      prefHeight="400"
                      style="-fx-background-color: white;
                             -fx-border-color: #D5DEE2;
                             -fx-border-radius: 10;
                             -fx-background-radius: 10;
                             -fx-padding: 5;"/>

        </VBox>
    </center>


    <!-- RODAPÉ -->
    <bottom>
        <HBox spacing="12"
              alignment="CENTER_RIGHT">

            <padding>
                <Insets top="10"
                        right="28"
                        bottom="25"
                        left="28"/>
            </padding>

            <!-- PAGAR -->
            <Button fx:id="botaoPagar"
                    text="PAGAR"
                    onAction="#pagarComandaSelecionada"
                    visible="false"
                    managed="false"
                    prefWidth="140"
                    prefHeight="48"
                    style="-fx-background-color: #28A745;
                           -fx-text-fill: white;
                           -fx-background-radius: 8;
                           -fx-font-weight: bold;
                           -fx-font-size: 14px;"/>

            <!-- NOVA COMANDA -->
            <Button fx:id="botaoAbrirComanda"
                    text="+  NOVA COMANDA"
                    onAction="#adicionarNovaComanda"
                    prefWidth="190"
                    prefHeight="48"
                    style="-fx-background-color: #ED8E22;
                           -fx-text-fill: #18272D;
                           -fx-background-radius: 8;
                           -fx-font-weight: bold;
                           -fx-font-size: 14px;"/>

        </HBox>
    </bottom>

</BorderPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="App.Controles.AbrirComandaController"
           style="-fx-background-color: #e9e9e9;"
           prefWidth="800.0"
           prefHeight="700.0">

    <children>

        <VBox maxWidth="740.0"
              maxHeight="640.0"
              prefWidth="740.0"
              prefHeight="640.0"
              spacing="0"
              style="-fx-background-color: #f7f9fa;
                     -fx-background-radius: 18;">

            <children>

                <!-- Cabeçalho -->
                <VBox spacing="4"
                      style="-fx-background-color: white;
                             -fx-background-radius: 18 18 0 0;">

                    <padding>
                        <Insets top="28"
                                right="36"
                                bottom="22"
                                left="36"/>
                    </padding>

                    <Label text="Abrir comanda"
                           style="-fx-font-size: 30px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #1f2d33;"/>

                
                </VBox>

                <!-- Conteúdo -->
                <VBox spacing="16"
                      VBox.vgrow="ALWAYS">

                    <padding>
                        <Insets top="34"
                                right="40"
                                bottom="10"
                                left="40"/>
                    </padding>

                    <!-- Tipo de atendimento -->
                    <VBox spacing="8">

                        <Label text="Tipo de atendimento *"
                               style="-fx-font-size: 16px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #26343a;"/>

                        <ComboBox fx:id="comboTipoAtendimento"
                                  maxWidth="Infinity"
                                  prefHeight="50"
                                  promptText="Selecione o tipo de atendimento"
                                  style="-fx-background-color: white;
                                         -fx-border-color: #d2dce0;
                                         -fx-border-radius: 7;
                                         -fx-background-radius: 7;
                                         -fx-font-size: 16px;"/>

                    </VBox>

                    <!-- Mesa -->
                    <VBox fx:id="caixaMesa"
                          spacing="8">

                        <Label fx:id="labelMesa"
                               text="Mesa livre *"
                               style="-fx-font-size: 16px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #26343a;"/>

                        <ComboBox fx:id="comboMesa"
                                  maxWidth="Infinity"
                                  prefHeight="50"
                                  promptText="Selecione uma mesa livre"
                                  style="-fx-background-color: white;
                                         -fx-border-color: #d2dce0;
                                         -fx-border-radius: 7;
                                         -fx-background-radius: 7;
                                         -fx-font-size: 16px;"/>

                    </VBox>

                    <!-- Texto auxiliar -->
                    <Label fx:id="labelAjuda"
                           text="Para cliente sem mesa, informe o nome abaixo."
                           wrapText="true"
                           style="-fx-font-size: 15px;
                                  -fx-text-fill: #7a8890;"/>

                    <!-- Nome -->
                    <VBox spacing="8">

                        <Label fx:id="labelNomeCliente"
                               text="Nome do cliente"
                               style="-fx-font-size: 16px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #26343a;"/>

                        <TextField fx:id="campoNomeCliente"
                                   prefHeight="50"
                                   maxWidth="Infinity"
                                   promptText="Obrigatório somente para Cliente sem mesa"
                                   style="-fx-background-color: white;
                                          -fx-border-color: #d2dce0;
                                          -fx-border-radius: 7;
                                          -fx-background-radius: 7;
                                          -fx-font-size: 16px;"/>

                    </VBox>

                    <!-- Mensagem de erro -->
                    <Label fx:id="labelErro"
                           managed="false"
                           visible="false"
                           wrapText="true"
                           style="-fx-text-fill: #b02a37;
                                  -fx-font-size: 14px;
                                  -fx-font-weight: bold;"/>

                </VBox>

                <!-- Botões -->
                <HBox alignment="CENTER_RIGHT"
                      spacing="18">

                    <padding>
                        <Insets top="10"
                                right="40"
                                bottom="26"
                                left="40"/>
                    </padding>

                    <Button text="CANCELAR"
                            onAction="#cancelar"
                            prefWidth="145"
                            prefHeight="52"
                            style="-fx-background-color: white;
                                   -fx-border-color: #d2dce0;
                                   -fx-border-radius: 8;
                                   -fx-background-radius: 8;
                                   -fx-font-size: 15px;
                                   -fx-font-weight: bold;
                                   -fx-text-fill: #26343a;"/>

                    <Button fx:id="botaoAbrir"
                            text="ABRIR"
                            defaultButton="true"
                            onAction="#confirmar"
                            prefWidth="145"
                            prefHeight="52"
                            style="-fx-background-color: #ef9023;
                                   -fx-background-radius: 8;
                                   -fx-font-size: 15px;
                                   -fx-font-weight: bold;
                                   -fx-text-fill: #1f2d33;"/>

                </HBox>

            </children>

        </VBox>

    </children>

</StackPane>
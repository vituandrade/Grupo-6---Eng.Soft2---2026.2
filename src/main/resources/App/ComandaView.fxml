<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="App.Controles.ComandaController"
            prefWidth="1180.0"
            prefHeight="720.0"
            style="-fx-background-color: #F5F7F8;">

    <!-- ===================================================== -->
    <!-- CABEÇALHO                                             -->
    <!-- ===================================================== -->

    <top>
        <VBox spacing="12"
              style="-fx-background-color: #0F2833;">

            <padding>
                <Insets top="22"
                        right="28"
                        bottom="20"
                        left="28"/>
            </padding>

            <Label fx:id="labelTituloComanda"
                   text="Comanda - Mesa X"
                   style="-fx-font-size: 24px;
                          -fx-font-weight: bold;
                          -fx-text-fill: white;"/>

            <HBox spacing="10"
                  alignment="CENTER_LEFT">

                <Label text="Pesquisar"
                       style="-fx-font-size: 14px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #C9D5DA;"/>

                <TextField fx:id="campoPesquisa"
                           promptText="Digite o nome do produto..."
                           HBox.hgrow="ALWAYS"
                           prefHeight="42"
                           style="-fx-background-color: white;
                                  -fx-background-radius: 7;
                                  -fx-border-radius: 7;
                                  -fx-border-color: #D5DEE2;
                                  -fx-font-size: 14px;"/>

            </HBox>

        </VBox>
    </top>


    <!-- ===================================================== -->
    <!-- ÁREA CENTRAL                                          -->
    <!-- ===================================================== -->

    <center>
        <SplitPane dividerPositions="0.56"
                   style="-fx-background-color: transparent;">

            <!-- ================================================= -->
            <!-- LADO ESQUERDO                                     -->
            <!-- ================================================= -->

            <VBox spacing="15"
                  style="-fx-background-color: white;
                         -fx-background-radius: 10;
                         -fx-border-color: #D5DEE2;
                         -fx-border-radius: 10;">

                <padding>
                    <Insets top="20"
                            right="20"
                            bottom="20"
                            left="20"/>
                </padding>

                <Label text="Selecionar produto"
                       style="-fx-font-size: 18px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #23343B;"/>

                <!-- Categorias -->
                <TabPane fx:id="tabPaneCategorias"
                         prefHeight="250"
                         VBox.vgrow="SOMETIMES"
                         tabClosingPolicy="UNAVAILABLE"
                         style="-fx-font-size: 13px;"/>

                <!-- Item selecionado -->
                <VBox spacing="5">

                    <Label text="Item selecionado"
                           style="-fx-font-size: 13px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #7A8890;"/>

                    <Label fx:id="labelItemSelecionado"
                           text="Selecione um item..."
                           wrapText="true"
                           style="-fx-font-size: 16px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #0F7EA8;"/>

                </VBox>

                <!-- Quantidade -->
                <HBox spacing="12"
                      alignment="CENTER_LEFT">

                    <Label text="Quantidade"
                           style="-fx-font-size: 14px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #23343B;"/>

                    <Spinner fx:id="spinnerQuantidade"
                             initialValue="1"
                             min="1"
                             max="99"
                             editable="true"
                             prefWidth="90"
                             prefHeight="40"
                             style="-fx-font-size: 14px;"/>

                </HBox>

                <!-- Observação -->
                <TextField fx:id="campoObservacao"
                           promptText="Observação (ex: sem gelo, mal passado)"
                           prefHeight="42"
                           style="-fx-background-color: #FFFFFF;
                                  -fx-background-radius: 7;
                                  -fx-border-color: #D5DEE2;
                                  -fx-border-radius: 7;
                                  -fx-font-size: 14px;"/>

                <!-- Adicionar -->
                <Button text="ADICIONAR À LISTA"
                        onAction="#adicionarAoCarrinho"
                        maxWidth="Infinity"
                        prefHeight="44"
                        style="-fx-background-color: #ED8E22;
                               -fx-text-fill: #18272D;
                               -fx-background-radius: 7;
                               -fx-font-size: 13px;
                               -fx-font-weight: bold;"/>

                <Separator/>

                <!-- Itens para enviar -->
                <Label text="Itens a enviar"
                       style="-fx-font-size: 16px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #23343B;"/>

                <ListView fx:id="listaCarrinho"
                          VBox.vgrow="ALWAYS"
                          prefHeight="170"
                          style="-fx-background-color: white;
                                 -fx-border-color: #D5DEE2;
                                 -fx-border-radius: 8;
                                 -fx-background-radius: 8;"/>

                <!-- Ações -->
                <HBox spacing="10">

                    <Button onAction="#removerDoCarrinho"
                            text="REMOVER ITEM"
                            prefHeight="42"
                            prefWidth="135"
                            style="-fx-background-color: #DC3545;
                                   -fx-text-fill: white;
                                   -fx-background-radius: 7;
                                   -fx-font-size: 12px;
                                   -fx-font-weight: bold;"/>

                    <Button onAction="#confirmarPedidoCompleto"
                            text="ENVIAR PEDIDO"
                            maxWidth="Infinity"
                            HBox.hgrow="ALWAYS"
                            prefHeight="42"
                            style="-fx-background-color: #28A745;
                                   -fx-text-fill: white;
                                   -fx-background-radius: 7;
                                   -fx-font-size: 13px;
                                   -fx-font-weight: bold;"/>

                </HBox>

            </VBox>


            <!-- ================================================= -->
            <!-- LADO DIREITO                                      -->
            <!-- ================================================= -->

            <VBox spacing="15"
                  style="-fx-background-color: white;
                         -fx-background-radius: 10;
                         -fx-border-color: #D5DEE2;
                         -fx-border-radius: 10;">

                <padding>
                    <Insets top="20"
                            right="20"
                            bottom="20"
                            left="20"/>
                </padding>

                <Label text="Histórico de pedidos"
                       style="-fx-font-size: 18px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #23343B;"/>

                <Label text="Pedidos registrados nesta comanda"
                       style="-fx-font-size: 13px;
                              -fx-text-fill: #7A8890;"/>

                <TreeView fx:id="arvorePedidos"
                          VBox.vgrow="ALWAYS"
                          showRoot="false"
                          style="-fx-background-color: white;
                                 -fx-border-color: #D5DEE2;
                                 -fx-border-radius: 8;
                                 -fx-background-radius: 8;"/>

                <Button fx:id="botaoRemPedido"
                        onAction="#removerPedido"
                        text="REMOVER PEDIDO SELECIONADO"
                        prefHeight="42"
                        maxWidth="Infinity"
                        style="-fx-background-color: #DC3545;
                               -fx-text-fill: white;
                               -fx-background-radius: 7;
                               -fx-font-size: 12px;
                               -fx-font-weight: bold;"/>

            </VBox>

        </SplitPane>
    </center>


    <!-- ===================================================== -->
    <!-- RODAPÉ                                                -->
    <!-- ===================================================== -->

    <bottom>
        <HBox alignment="CENTER_RIGHT"
              spacing="22"
              style="-fx-background-color: #0F2833;">

            <padding>
                <Insets top="16"
                        right="24"
                        bottom="16"
                        left="24"/>
            </padding>

            <Label fx:id="labelTotal"
                   text="Total: R$ 0,00"
                   style="-fx-font-size: 20px;
                          -fx-font-weight: bold;
                          -fx-text-fill: white;"/>

            <Button fx:id="botaoFecharComanda"
                    onAction="#fecharComanda"
                    text="FECHAR COMANDA"
                    prefWidth="170"
                    prefHeight="44"
                    style="-fx-background-color: #ED8E22;
                           -fx-text-fill: #18272D;
                           -fx-background-radius: 7;
                           -fx-font-size: 13px;
                           -fx-font-weight: bold;"/>

        </HBox>
    </bottom>

</BorderPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="App.Controles.ComandaController"
            prefWidth="1180.0"
            prefHeight="720.0"
            style="-fx-background-color: #F5F7F8;">

    <top>
        <HBox alignment="CENTER_LEFT"
              prefHeight="64.0"
              style="-fx-background-color: white;">

            <padding>
                <Insets top="12"
                        right="22"
                        bottom="12"
                        left="22"/>
            </padding>

            <Button text="← VOLTAR"
                    onAction="#voltar"
                    prefWidth="90.0"
                    prefHeight="34.0"
                    style="-fx-background-color: white;
                           -fx-text-fill: #45545C;
                           -fx-border-color: #D5DEE2;
                           -fx-border-radius: 5;
                           -fx-background-radius: 5;
                           -fx-font-size: 10px;
                           -fx-font-weight: bold;"/>

            <VBox spacing="3"
                  HBox.hgrow="ALWAYS"
                  style="-fx-padding: 0 0 0 16;">

                <Label fx:id="labelTituloComanda"
                       text="Comanda #107 • Mesa 07"
                       style="-fx-font-size: 18px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #27343A;"/>

                <Label text="Itens e pedidos desta comanda"
                       style="-fx-font-size: 11px;
                              -fx-text-fill: #7A8890;"/>

            </VBox>

            <Label text="Funcionário autorizado"
                   style="-fx-font-size: 10px;
                          -fx-text-fill: #7A8890;"/>

        </HBox>
    </top>

    <center>
        <VBox spacing="14">

            <padding>
                <Insets top="16"
                        right="22"
                        bottom="16"
                        left="22"/>
            </padding>

            <HBox spacing="18"
                  alignment="TOP_CENTER"
                  VBox.vgrow="ALWAYS">

                <VBox prefWidth="650.0"
                      minWidth="500.0"
                      maxWidth="720.0"
                      spacing="12"
                      style="-fx-background-color: white;
                             -fx-background-radius: 8;
                             -fx-border-color: #D8E0E3;
                             -fx-border-radius: 8;">

                    <padding>
                        <Insets top="16"
                                right="16"
                                bottom="16"
                                left="16"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT">

                        <Label text="Itens do pedido"
                               style="-fx-font-size: 15px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #27343A;"/>

                        <Label text="Histórico da comanda"
                               maxWidth="Infinity"
                               HBox.hgrow="ALWAYS"
                               alignment="CENTER_RIGHT"
                               style="-fx-font-size: 10px;
                                      -fx-text-fill: #7A8890;"/>

                    </HBox>

                    <TreeView fx:id="arvorePedidos"
                              showRoot="false"
                              VBox.vgrow="ALWAYS"
                              style="-fx-background-color: white;
                                     -fx-border-color: #D8E0E3;
                                     -fx-border-radius: 6;
                                     -fx-background-radius: 6;"/>

                    <HBox spacing="8"
                          alignment="CENTER_LEFT">

                        <Label text="Itens"
                               style="-fx-font-size: 11px;
                                      -fx-text-fill: #7A8890;"/>

                        <Label fx:id="labelTotal"
                               text="Total: R$ 0,00"
                               maxWidth="Infinity"
                               HBox.hgrow="ALWAYS"
                               alignment="CENTER_RIGHT"
                               style="-fx-font-size: 15px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #27343A;"/>

                    </HBox>

                    <HBox spacing="10">

                        <Button text="REMOVER PEDIDO SELECIONADO"
                                onAction="#removerPedido"
                                prefHeight="38.0"
                                maxWidth="Infinity"
                                HBox.hgrow="ALWAYS"
                                style="-fx-background-color: #DC3545;
                                       -fx-text-fill: white;
                                       -fx-background-radius: 5;
                                       -fx-font-size: 10px;
                                       -fx-font-weight: bold;"/>

                        <Button text="ENVIAR PEDIDO"
                                onAction="#confirmarPedidoCompleto"
                                prefHeight="38.0"
                                maxWidth="Infinity"
                                HBox.hgrow="ALWAYS"
                                style="-fx-background-color: #28A745;
                                       -fx-text-fill: white;
                                       -fx-background-radius: 5;
                                       -fx-font-size: 10px;
                                       -fx-font-weight: bold;"/>

                    </HBox>

                </VBox>

                <VBox prefWidth="330.0"
                      minWidth="300.0"
                      maxWidth="380.0"
                      spacing="11"
                      style="-fx-background-color: white;
                             -fx-background-radius: 8;
                             -fx-border-color: #D8E0E3;
                             -fx-border-radius: 8;">

                    <padding>
                        <Insets top="16"
                                right="16"
                                bottom="16"
                                left="16"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT">

                        <Label text="Adicionar item"
                               style="-fx-font-size: 15px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #27343A;"/>

                    </HBox>

                    <Label text="Item do cardápio"
                           style="-fx-font-size: 11px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #3D4A50;"/>

                    <TextField fx:id="campoPesquisa"
                               promptText="Digite o nome do produto..."
                               prefHeight="36.0"
                               style="-fx-background-color: white;
                                      -fx-border-color: #D5DEE2;
                                      -fx-border-radius: 5;
                                      -fx-background-radius: 5;
                                      -fx-font-size: 11px;"/>

                    <ScrollPane fitToWidth="true"
                                prefHeight="145.0"
                                maxHeight="145.0"
                                style="-fx-background-color: transparent;
                                       -fx-border-color: transparent;">

                        <content>
                            <TabPane fx:id="tabPaneCategorias"
                                     tabClosingPolicy="UNAVAILABLE"
                                     style="-fx-font-size: 10px;"/>
                        </content>

                    </ScrollPane>

                    <Label text="Item selecionado"
                           style="-fx-font-size: 11px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #3D4A50;"/>

                    <Label fx:id="labelItemSelecionado"
                           text="Selecione um item..."
                           wrapText="true"
                           style="-fx-font-size: 12px;
                                  -fx-text-fill: #1680A0;
                                  -fx-font-weight: bold;"/>

                    <HBox alignment="CENTER_LEFT"
                          spacing="10">

                        <Label text="Quantidade"
                               style="-fx-font-size: 11px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #3D4A50;"/>

                        <Spinner fx:id="spinnerQuantidade"
                                 prefWidth="90.0"
                                 prefHeight="34.0"
                                 editable="true"/>

                    </HBox>

                    <TextField fx:id="campoObservacao"
                               promptText="Observação (ex: sem gelo, mal passado)"
                               prefHeight="36.0"
                               style="-fx-background-color: white;
                                      -fx-border-color: #D5DEE2;
                                      -fx-border-radius: 5;
                                      -fx-background-radius: 5;
                                      -fx-font-size: 11px;"/>

                    <Button text="ADICIONAR À LISTA"
                            onAction="#adicionarAoCarrinho"
                            prefHeight="38.0"
                            maxWidth="Infinity"
                            style="-fx-background-color: #ED8E22;
                                   -fx-text-fill: #1F2E33;
                                   -fx-background-radius: 5;
                                   -fx-font-size: 10px;
                                   -fx-font-weight: bold;"/>

                    <Label text="Itens a enviar"
                           style="-fx-font-size: 11px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #3D4A50;"/>

                    <ListView fx:id="listaCarrinho"
                              prefHeight="75.0"
                              minHeight="75.0"
                              maxHeight="75.0"
                              style="-fx-background-color: white;
                                     -fx-border-color: #D8E0E3;
                                     -fx-border-radius: 5;
                                     -fx-background-radius: 5;"/>

                    <Button text="CANCELAR ITEM"
                            onAction="#removerDoCarrinho"
                            prefHeight="36.0"
                            maxWidth="Infinity"
                            style="-fx-background-color: white;
                                   -fx-text-fill: #DC3545;
                                   -fx-border-color: #DC3545;
                                   -fx-border-radius: 5;
                                   -fx-background-radius: 5;
                                   -fx-font-size: 10px;
                                   -fx-font-weight: bold;"/>

                </VBox>

            </HBox>

        </VBox>
    </center>

</BorderPane>
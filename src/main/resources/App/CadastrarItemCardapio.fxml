<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="500.0" spacing="8.0" styleClass="cadastro-item"
      stylesheets="@Cardapio.css" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="App.Controles.CadastrarItemCardapioController">
    <padding>
        <Insets bottom="4.0" left="4.0" right="4.0" top="4.0" />
    </padding>

    <Label styleClass="dialog-subtitle" text="Campos marcados com * são obrigatórios." />

    <Label styleClass="form-label" text="Nome *">
        <VBox.margin><Insets top="8.0" /></VBox.margin>
    </Label>
    <TextField fx:id="campoNome" prefHeight="40.0" promptText="Ex.: X-Burger" />

    <Label styleClass="form-label" text="Categoria *">
        <VBox.margin><Insets top="4.0" /></VBox.margin>
    </Label>
    <ComboBox fx:id="campoCategoria" maxWidth="Infinity" prefHeight="40.0"
              promptText="Selecione: Lanche, Bebida, Prato ou Sobremesa" />

    <Label styleClass="form-label" text="Descrição">
        <VBox.margin><Insets top="4.0" /></VBox.margin>
    </Label>
    <TextArea fx:id="campoDescricao" prefHeight="64.0" promptText="Descrição opcional do item" wrapText="true" />

    <HBox spacing="20.0">
        <children>
            <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Preço *" />
                <TextField fx:id="campoPreco" prefHeight="40.0" promptText="R$ 0,00" />
            </VBox>
            <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Disponibilidade *" />
                <ComboBox fx:id="campoDisponibilidade" maxWidth="Infinity" prefHeight="40.0" />
            </VBox>
        </children>
        <VBox.margin><Insets top="4.0" /></VBox.margin>
    </HBox>

    <Label styleClass="form-hint" text="Preço deve ser maior que zero.">
        <VBox.margin><Insets top="5.0" /></VBox.margin>
    </Label>
    <Label styleClass="form-hint" text="Item indisponível não pode ser incluído em pedidos." />
    <Label fx:id="mensagemValidacao" minHeight="22.0" styleClass="form-error" wrapText="true" />
</VBox>

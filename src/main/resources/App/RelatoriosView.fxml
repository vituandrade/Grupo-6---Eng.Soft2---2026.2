<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="App.Controles.RelatoriosController"
            styleClass="relatorios-root"
            stylesheets="@Relatorios.css">

    <center>
        <VBox spacing="16.0">
            <padding>
                <Insets top="24.0" right="32.0" bottom="24.0" left="32.0"/>
            </padding>

            <Label text="Relatórios locais"
                   styleClass="section-title"/>

            <HBox spacing="16.0" fillHeight="true" prefHeight="112.0" minHeight="104.0" maxHeight="118.0">
                <Button fx:id="botaoVendas"
                        maxWidth="Infinity"
                        maxHeight="Infinity"
                        HBox.hgrow="ALWAYS"
                        onAction="#selecionarVendas"
                        styleClass="report-card">
                    <graphic>
                        <HBox spacing="12.0" alignment="CENTER_LEFT">
                            <Region prefWidth="5.0" minWidth="5.0" maxWidth="5.0" prefHeight="52.0" maxHeight="52.0" styleClass="stripe-vendas"/>
                            <VBox spacing="5.0" prefWidth="155.0">
                                <Label text="Vendas" styleClass="report-card-title"/>
                                <Label text="Resumo por período" styleClass="report-card-subtitle" wrapText="true"/>
                            </VBox>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="botaoItensMaisVendidos"
                        maxWidth="Infinity"
                        maxHeight="Infinity"
                        HBox.hgrow="ALWAYS"
                        onAction="#selecionarItensMaisVendidos"
                        styleClass="report-card">
                    <graphic>
                        <HBox spacing="12.0" alignment="CENTER_LEFT">
                            <Region prefWidth="5.0" minWidth="5.0" maxWidth="5.0" prefHeight="52.0" maxHeight="52.0" styleClass="stripe-itens"/>
                            <VBox spacing="5.0" prefWidth="155.0">
                                <Label text="Itens mais vendidos" styleClass="report-card-title"/>
                                <Label text="Ranking de produtos" styleClass="report-card-subtitle" wrapText="true"/>
                            </VBox>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="botaoConsumo"
                        maxWidth="Infinity"
                        maxHeight="Infinity"
                        HBox.hgrow="ALWAYS"
                        onAction="#selecionarConsumo"
                        styleClass="report-card">
                    <graphic>
                        <HBox spacing="12.0" alignment="CENTER_LEFT">
                            <Region prefWidth="5.0" minWidth="5.0" maxWidth="5.0" prefHeight="52.0" maxHeight="52.0" styleClass="stripe-consumo"/>
                            <VBox spacing="5.0" prefWidth="155.0">
                                <Label text="Consumo por período" styleClass="report-card-title" wrapText="true"/>
                                <Label text="Movimentação registrada" styleClass="report-card-subtitle" wrapText="true"/>
                            </VBox>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="botaoEstoque"
                        maxWidth="Infinity"
                        maxHeight="Infinity"
                        HBox.hgrow="ALWAYS"
                        onAction="#selecionarEstoque"
                        styleClass="report-card">
                    <graphic>
                        <HBox spacing="12.0" alignment="CENTER_LEFT">
                            <Region prefWidth="5.0" minWidth="5.0" maxWidth="5.0" prefHeight="52.0" maxHeight="52.0" styleClass="stripe-estoque"/>
                            <VBox spacing="5.0" prefWidth="155.0">
                                <Label text="Estoque" styleClass="report-card-title"/>
                                <Label text="Saldo e itens críticos" styleClass="report-card-subtitle" wrapText="true"/>
                            </VBox>
                        </HBox>
                    </graphic>
                </Button>
            </HBox>

            <VBox spacing="14.0" prefHeight="505.0" minHeight="480.0" maxHeight="535.0" styleClass="content-card">
                <VBox spacing="3.0">
                    <Label fx:id="labelTituloRelatorio"
                           text="Relatório de vendas"
                           styleClass="card-title"/>
                    <Label fx:id="labelSubtituloRelatorio"
                           text="Resumo das vendas realizadas no período"
                           styleClass="card-subtitle"/>
                </VBox>

                <HBox spacing="12.0" alignment="CENTER_LEFT" prefHeight="42.0">
                    <VBox spacing="4.0" prefWidth="180.0" minWidth="180.0">
                        <Label fx:id="labelDataInicial" text="Data inicial" styleClass="field-label"/>
                        <TextField fx:id="campoDataInicial" promptText="DD/MM/AAAA" prefHeight="42.0"/>
                    </VBox>

                    <Label fx:id="labelAte" text="até" styleClass="field-label" prefWidth="26.0" alignment="CENTER"/>

                    <VBox spacing="4.0" prefWidth="180.0" minWidth="180.0">
                        <Label fx:id="labelDataFinal" text="Data final" styleClass="field-label"/>
                        <TextField fx:id="campoDataFinal" promptText="DD/MM/AAAA" prefHeight="42.0"/>
                    </VBox>

                    <Button fx:id="botaoGerar"
                            text="GERAR"
                            onAction="#gerarRelatorio"
                            prefWidth="132.0"
                            minWidth="132.0"
                            prefHeight="42.0"
                            styleClass="primary-button"/>
                </HBox>

                <HBox spacing="14.0">
                    <VBox spacing="6.0" HBox.hgrow="ALWAYS" styleClass="summary-card">
                        <Label fx:id="labelResumo1" text="Total vendido" styleClass="summary-label"/>
                        <Label fx:id="labelValor1" text="R$ 0,00" styleClass="summary-value"/>
                    </VBox>
                    <VBox spacing="6.0" HBox.hgrow="ALWAYS" styleClass="summary-card">
                        <Label fx:id="labelResumo2" text="Comandas fechadas" styleClass="summary-label"/>
                        <Label fx:id="labelValor2" text="0" styleClass="summary-value"/>
                    </VBox>
                    <VBox spacing="6.0" HBox.hgrow="ALWAYS" styleClass="summary-card">
                        <Label fx:id="labelResumo3" text="Ticket médio" styleClass="summary-label"/>
                        <Label fx:id="labelValor3" text="R$ 0,00" styleClass="summary-value"/>
                    </VBox>
                </HBox>

                <TableView fx:id="tabela" prefHeight="260.0" minHeight="220.0" maxHeight="285.0" styleClass="report-table">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="coluna1" text="Comanda" prefWidth="300.0"/>
                        <TableColumn fx:id="coluna2" text="Atendimento" prefWidth="420.0"/>
                        <TableColumn fx:id="coluna3" text="Total" prefWidth="260.0"/>
                    </columns>
                </TableView>

                <Label fx:id="labelMensagem"
                       minHeight="18.0"
                       styleClass="message-label"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>

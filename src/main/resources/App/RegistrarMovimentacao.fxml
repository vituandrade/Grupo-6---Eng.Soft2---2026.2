<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="500.0" spacing="9.0" styleClass="movimentacao-form"
      stylesheets="@Estoque.css" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="App.Controles.RegistrarMovimentacaoController">
    <padding>
        <Insets bottom="4.0" left="4.0" right="4.0" top="4.0" />
    </padding>

    <Label styleClass="dialog-subtitle"
           text="Entrada soma e Saída subtrai o saldo." />

    <Label styleClass="form-label" text="Item *">
        <VBox.margin><Insets top="10.0" /></VBox.margin>
    </Label>
    <ComboBox fx:id="campoItem" editable="true" maxWidth="Infinity"
              prefHeight="42.0" promptText="Selecione ou digite um item novo" />

    <HBox spacing="20.0">
        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
            <Label styleClass="form-label" text="Tipo *" />
            <ComboBox fx:id="campoTipo" maxWidth="Infinity" prefHeight="42.0" />
        </VBox>
        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
            <Label styleClass="form-label" text="Quantidade *" />
            <TextField fx:id="campoQuantidade" prefHeight="42.0" promptText="0" />
        </VBox>
        <VBox.margin><Insets top="5.0" /></VBox.margin>
    </HBox>

    <Label styleClass="form-label" text="Unidade de medida">
        <VBox.margin><Insets top="5.0" /></VBox.margin>
    </Label>
    <TextField fx:id="campoUnidade" prefHeight="42.0"
               promptText="Ex.: kg, un., L" />

    <Label styleClass="form-hint"
           text="Para item novo, digite o nome no campo Item e informe a unidade.">
        <VBox.margin><Insets top="7.0" /></VBox.margin>
    </Label>
    <Label styleClass="form-hint"
           text="Saídas maiores que o saldo disponível serão recusadas." />
    <Label fx:id="mensagemValidacao" minHeight="30.0"
           styleClass="form-error" wrapText="true" />
</VBox>
